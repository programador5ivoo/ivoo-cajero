# URL base de la API IVOO+ (ivoo-plus-api).
# Sin esta variable el portal corre contra el mock en memoria y muestra la
# barra amarilla de "modo demo".
# VITE_IVOO_API_URL=https://api.ivoo.plus

# Horas de retención de gemas antes de validar la factura. Default: 4.
# Acepta decimales para QA (0.0008 ≈ 3 segundos). NO definir en producción.
# VITE_RETENTION_HOURS=4
